rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── MASTER KILL SWITCH ─────────────────────────────────────────────────
    // Used by every rule that requires the school to be active and paying.
    function isSchoolActive(schoolId) {
      return exists(/databases/$(database)/documents/schools/$(schoolId)) &&
             get(/databases/$(database)/documents/schools/$(schoolId)).data.isVerified == true;
    }

    // ── PASS A: TENANT IDENTITY CHECK ───────────────────────────────────────
    // isSchoolActive() only ever checks the TARGET school's own doc — it never
    // looks at who is calling. That is the root cause of the cross-tenant gap
    // Pass A closes: any authenticated user at ANY active school (or, before
    // this pass, even an unauthenticated caller) could read/write another
    // active school's data, because isSchoolActive(schoolId) was the ONLY
    // gate. isCallerInSchool(schoolId) adds the missing identity check —
    // the caller's own token must carry the schoolId being accessed.
    function isCallerInSchool(schoolId) {
      return request.auth != null && request.auth.token.schoolId == schoolId;
    }

    // ── 1. National Teacher Registry ──────────────────────────────────────
    match /teachers/{teacherId} {
      // GET: teacher is active at a verified school, OR currentSchoolId is
      //      empty (claimed teacher search, restore flow).
      allow get: if resource.data.currentSchoolId == null
                 || resource.data.currentSchoolId == ''
                 || isSchoolActive(resource.data.currentSchoolId);

      // LIST: open — needed by admin portal, teacher portal, student portal,
      //       and HQ dashboard (all query with where() filters).
      allow list: if true;

      // CREATE: only when the school being assigned to is active.
      allow create: if isSchoolActive(request.resource.data.currentSchoolId);

      // UPDATE: school is active (normal operations), OR the doc currently
      //         has no school (restore from archive sets currentSchoolId back),
      //         OR the school being archived from is in archivedSchoolIds
      //         (allows the restore updateDoc to succeed).
      allow update: if resource.data.currentSchoolId == null
                    || resource.data.currentSchoolId == ''
                    || isSchoolActive(resource.data.currentSchoolId)
                    || (resource.data.archivedSchoolIds != null &&
                        request.auth != null &&
                        request.auth.token.schoolId in resource.data.archivedSchoolIds);

      // DELETE: disabled — soft deletes only.
      allow delete: if false;

      match /evaluations/{evalId} {
        allow read, create, update:
          if isSchoolActive(
            get(/databases/$(database)/documents/teachers/$(teacherId)).data.currentSchoolId
          );
        allow delete: if false;
      }
    }

    // ── 2. National Student Registry ──────────────────────────────────────
    match /students/{studentId} {
      // GET: student is at an active school, OR released/archived
      //      (currentSchoolId empty) — needed by student login (unauthenticated)
      //      and teacher claim search.
      allow get: if resource.data.currentSchoolId == null
                 || resource.data.currentSchoolId == ''
                 || isSchoolActive(resource.data.currentSchoolId);

      // LIST: open — needed by admin portal, teacher portal (roster, gradebook,
      //       reports, home, subjects), and HQ dashboard.
      allow list: if true;

      // CREATE: only when the school being assigned to is active.
      allow create: if isSchoolActive(request.resource.data.currentSchoolId);

      // UPDATE: school is active (normal), OR student is released/archived
      //         (currentSchoolId empty — restore, claim, student settings update).
      allow update: if resource.data.currentSchoolId == null
                    || resource.data.currentSchoolId == ''
                    || isSchoolActive(resource.data.currentSchoolId);

      // DELETE: teacher/archives.js permanentDeleteStudent hard-deletes the
      //         student doc. Must be authenticated AND the student is either
      //         at an active school or has no current school (released).
      allow delete: if request.auth != null &&
                       (resource.data.currentSchoolId == null ||
                        resource.data.currentSchoolId == '' ||
                        isSchoolActive(resource.data.currentSchoolId));

      match /grades/{gradeId} {
        // READ: school active OR student released (history.js reads grades
        //       for released students whose currentSchoolId is now empty).
        allow read: if get(/databases/$(database)/documents/students/$(studentId)).data.currentSchoolId == null
                    || get(/databases/$(database)/documents/students/$(studentId)).data.currentSchoolId == ''
                    || isSchoolActive(
                         get(/databases/$(database)/documents/students/$(studentId)).data.currentSchoolId
                       );

        // WRITE: school must be active (no grade entry after suspension).
        allow create, update: if isSchoolActive(
          get(/databases/$(database)/documents/students/$(studentId)).data.currentSchoolId
        );

        // DELETE: gradebook edit and permanentDeleteStudent both delete grades.
        allow delete: if isSchoolActive(
          get(/databases/$(database)/documents/students/$(studentId)).data.currentSchoolId
        ) || get(/databases/$(database)/documents/students/$(studentId)).data.currentSchoolId == null
          || get(/databases/$(database)/documents/students/$(studentId)).data.currentSchoolId == '';
      }

      match /evaluations/{evalId} {
        allow read, create, update:
          if isSchoolActive(
            get(/databases/$(database)/documents/students/$(studentId)).data.currentSchoolId
          );
        allow delete: if false;
      }

      // ── 2a. Assignment submissions (ConnectUs Phase 0) ───────────────────
      // Deliberately NOT nested under schools/{schoolId}/classes/.../assignments/.
      // Anything nested under schools/{schoolId} — at any depth — already
      // inherits the broad isSchoolActive()-only grant from the generic
      // schools/{schoolId}/{subcollection=**} wildcard below (section 3).
      // Firestore ORs together every rule that matches a given path, so a
      // stricter rule placed deeper inside that wildcard's reach can never
      // actually restrict access — the broad grant still applies regardless.
      // Living under the student registry instead (same reason grades and
      // evaluations already live here) lets a submission carry its own
      // rule that checks the caller's actual identity, not just whether
      // their school is active.
      match /submissions/{submissionId} {
        // READ: the school must be active, AND the caller is either the
        //       owning student or a teacher/admin at that same school.
        allow read: if isSchoolActive(
                        get(/databases/$(database)/documents/students/$(studentId)).data.currentSchoolId
                      ) &&
                      request.auth != null &&
                      (request.auth.token.studentId == studentId ||
                       (request.auth.token.role in ['teacher', 'super_admin', 'sub_admin'] &&
                        request.auth.token.schoolId ==
                          get(/databases/$(database)/documents/students/$(studentId)).data.currentSchoolId));

        // CREATE: only the owning student, only while their school is active.
        allow create: if isSchoolActive(
                          get(/databases/$(database)/documents/students/$(studentId)).data.currentSchoolId
                        ) &&
                        request.auth != null &&
                        request.auth.token.studentId == studentId;

        // UPDATE: the owning student may keep editing their own submission
        //         only while it isn't graded yet; a teacher/admin at that
        //         school may update it any time (grading, comments).
        allow update: if isSchoolActive(
                          get(/databases/$(database)/documents/students/$(studentId)).data.currentSchoolId
                        ) &&
                        request.auth != null &&
                        ((request.auth.token.studentId == studentId &&
                          resource.data.status != 'graded') ||
                         (request.auth.token.role in ['teacher', 'super_admin', 'sub_admin'] &&
                          request.auth.token.schoolId ==
                            get(/databases/$(database)/documents/students/$(studentId)).data.currentSchoolId));

        allow delete: if false;
      }

      // ── 2b. Exam submissions (ConnectUs Phase 2) ──────────────────────────
      // Same reasoning and same shape as assignment submissions above.
      match /exam_submissions/{examSubmissionId} {
        allow read: if isSchoolActive(
                        get(/databases/$(database)/documents/students/$(studentId)).data.currentSchoolId
                      ) &&
                      request.auth != null &&
                      (request.auth.token.studentId == studentId ||
                       (request.auth.token.role in ['teacher', 'super_admin', 'sub_admin'] &&
                        request.auth.token.schoolId ==
                          get(/databases/$(database)/documents/students/$(studentId)).data.currentSchoolId));

        // CREATE/UPDATE: the owning student may write their own answers while
        //         the submission is in_progress or submitted, but never the
        //         `score` field directly — only the autoGradeObjectiveAnswers
        //         Cloud Function (Admin SDK, bypasses these rules) sets that.
        //         A teacher/admin at that school may update any time (manual
        //         grading of free-response answers).
        allow create: if isSchoolActive(
                          get(/databases/$(database)/documents/students/$(studentId)).data.currentSchoolId
                        ) &&
                        request.auth != null &&
                        request.auth.token.studentId == studentId &&
                        !('score' in request.resource.data.keys());

        allow update: if isSchoolActive(
                          get(/databases/$(database)/documents/students/$(studentId)).data.currentSchoolId
                        ) &&
                        request.auth != null &&
                        ((request.auth.token.studentId == studentId &&
                          resource.data.status != 'graded' &&
                          !('score' in request.resource.data.diff(resource.data).affectedKeys())) ||
                         (request.auth.token.role in ['teacher', 'super_admin', 'sub_admin'] &&
                          request.auth.token.schoolId ==
                            get(/databases/$(database)/documents/students/$(studentId)).data.currentSchoolId));

        allow delete: if false;
      }
    }

    // ── 3. Siloed School Data ──────────────────────────────────────────────
    match /schools/{schoolId} {
      // GET/LIST: public — needed by login pages, student portal, teacher
      //           portal (all read school doc without school-specific auth).
      allow get, list: if true;

      // CREATE: onboarding.js creates the school doc during signup.
      //         The user is unauthenticated at that point (no school session
      //         yet), so this must remain open. The onboarding page is only
      //         reachable via a one-time signed link from HQ.
      allow create: if true;

      // UPDATE: three legitimate paths —
      //   (a) The school's own super_admin via their verified session.
      //       mintAdminToken issues tokens with the schoolId claim, so this
      //       also covers first-time setup right after login.
      //   (b) An HQ platform_admin (HQ dashboard, hq-schools.js).
      //   (c) Unauthenticated PIN reset from reset-pin.html — only allowed
      //       to touch the PIN reset fields. The reset_vault token (which is
      //       short-lived and unguessable) gates access to the page itself.
      //       Limiting affectedKeys to the three reset fields ensures an
      //       attacker without the token cannot modify isVerified, limits,
      //       contactEmail, or any other field.
      allow update: if (request.auth != null &&
                        request.auth.token.schoolId == schoolId) ||
                       (request.auth != null &&
                        request.auth.token.role == 'platform_admin') ||
                       (request.resource.data.diff(resource.data).affectedKeys()
                          .hasOnly(['adminCode', 'requiresPinReset', 'lastPinResetAt']));

      // DELETE: disabled.
      allow delete: if false;

      match /admins/{adminId} {
        // READ/UPDATE: the caller must belong to THIS school (identity check)
        //              AND the school must be active. Previously isSchoolActive
        //              alone meant any active-school caller — or, per the
        //              subcollection wildcard nested below, potentially an
        //              unauthenticated one — could read/edit another school's
        //              admin records.
        allow read, update: if isCallerInSchool(schoolId) && isSchoolActive(schoolId);

        // CREATE: normal path requires caller identity + active school.
        //         Bootstrap path (onboarding.js's atomic writeBatch creating
        //         the school doc and its first records together) is scoped
        //         with !exists(...) so it only ever fires the FIRST time a
        //         school is created — existsAfter()/getAfter() alone describe
        //         only the state AFTER this write, which is equally true for
        //         a replay against an already-existing verified school. Pass
        //         A patches that replay hole.
        allow create: if (isCallerInSchool(schoolId) && isSchoolActive(schoolId)) ||
                         (!exists(/databases/$(database)/documents/schools/$(schoolId)) &&
                          existsAfter(/databases/$(database)/documents/schools/$(schoolId)) &&
                          getAfter(/databases/$(database)/documents/schools/$(schoolId)).data.isVerified == true);

        // DELETE: unchanged — already denied to everyone (soft-delete only
        //         model, same as teachers/students/schools). Nothing to
        //         tighten: `false` cannot be made more restrictive.
        allow delete: if false;

        match /{subcollection=**} {
          allow read, update: if isCallerInSchool(schoolId) && isSchoolActive(schoolId);
          allow create: if (isCallerInSchool(schoolId) && isSchoolActive(schoolId)) ||
                           (!exists(/databases/$(database)/documents/schools/$(schoolId)) &&
                            existsAfter(/databases/$(database)/documents/schools/$(schoolId)) &&
                            getAfter(/databases/$(database)/documents/schools/$(schoolId)).data.isVerified == true);
          allow delete: if false;
        }
      }

      // ── 3a. Classes: Per-Class Isolation (PASS B, PART 2) ─────────────────
      // schools/{schoolId}/classes/{classId} — the class document itself —
      // is carved out of the generic wildcard below and given a stricter GET
      // grant. Pass A's isCallerInSchool(schoolId) proves the caller belongs
      // to THIS SCHOOL, but says nothing about which CLASS they belong to:
      // under Pass A alone, any teacher or student at an active school could
      // still read every OTHER class's document at that same school, even
      // one they have no relationship to. Per-class isolation adds that
      // missing check via a get() lookup on the resource the caller is
      // claiming membership in (teacherIds, for a teacher) or on the
      // caller's OWN doc (a student's classId lives on their student doc,
      // not on their auth token).
      //
      // NOTE on two earlier, broken attempts at this block, kept here so the
      // reasoning isn't re-litigated later:
      //   1. Guarding the sibling wildcard below with a
      //      `subcollection.size() == 2` check, to distinguish the bare
      //      class doc from paths nested under it. The real emulator
      //      rejected this at runtime — "Function not found error: Name:
      //      [size]" — a recursive wildcard's bound value supports index
      //      access (path[0]) but not a .size()/.length method here.
      //   2. Replacing that with a nested `match /{deeperPath=**}` directly
      //      under /classes/{classId}, on the theory that a nested match
      //      can only ever compose onto something STRICTLY DEEPER than its
      //      parent. That's wrong: a recursive wildcard matches ZERO OR MORE
      //      segments, so {deeperPath=**} ALSO matched the bare class doc
      //      itself (deeperPath == []) — its broad read grant then OR'd
      //      with the stricter GET rule below and silently defeated the
      //      isolation (confirmed by Justine's test run: a teacher could
      //      still read another teacher's class).
      // Fixed by dropping recursive wildcards entirely for this subtree and
      // explicitly matching each known nested collection by name instead
      // (subjects, attendance, and subjects' own assignments/posts/
      // submissions — the complete set actually used anywhere in this
      // codebase, confirmed by grep). A named single-segment match like
      // `match /subjects/{subjectId}` has no zero-segment case — it requires
      // that literal segment to be present — so there is no ambiguity left.
      match /classes/{classId} {
        // GET: three ways in —
        //   (a) an admin (super_admin/sub_admin) at this school — unrestricted,
        //       same as every other admin read in this file.
        //   (b) a teacher whose own teacherId appears in THIS class's
        //       teacherIds array (resource.data — the class doc being read).
        //   (c) a student whose OWN classId (fetched via get() on their
        //       student doc, since the token only carries studentId) matches
        //       THIS classId.
        // A teacher assigned to a different class, or a student enrolled in
        // a different class, satisfies isCallerInSchool(schoolId) but fails
        // all three checks above and is correctly denied — this is the
        // isolation Pass A's school-level check didn't provide.
        allow get: if isCallerInSchool(schoolId) && isSchoolActive(schoolId) && (
          request.auth.token.role in ['super_admin', 'sub_admin'] ||
          (request.auth.token.role == 'teacher' &&
           request.auth.token.teacherId in resource.data.teacherIds) ||
          (request.auth.token.role == 'student' &&
           get(/databases/$(database)/documents/students/$(request.auth.token.studentId)).data.classId == classId)
        );

        // LIST/CREATE/UPDATE/DELETE on the class doc itself: intentionally
        //       left at the same isCallerInSchool(schoolId) &&
        //       isSchoolActive(schoolId) grant as before (identical to the
        //       generic wildcard this block is carved out of). admin/
        //       classes.js, admin/teachers.js, admin/students.js, admin/
        //       reports.js, teacher/roster.js, and assets/js/utils.js all
        //       fetch the FULL unfiltered classes collection today and
        //       filter client-side; narrowing LIST to a per-caller query
        //       would require rewriting every one of those call sites to a
        //       server-verifiable where() clause, which is a frontend change
        //       outside this pass's ask (per-class GET isolation). Nothing
        //       in the current codebase has a teacher or student directly
        //       create/update/delete a class document, so leaving those at
        //       the broader same-school grant carries no practical risk
        //       today — tightening them to admin-only is a reasonable
        //       future hardening step, flagged here rather than done
        //       silently since it wasn't asked for in this pass.
        allow list: if isCallerInSchool(schoolId) && isSchoolActive(schoolId);
        allow create: if (isCallerInSchool(schoolId) && isSchoolActive(schoolId)) ||
                         (!exists(/databases/$(database)/documents/schools/$(schoolId)) &&
                          existsAfter(/databases/$(database)/documents/schools/$(schoolId)) &&
                          getAfter(/databases/$(database)/documents/schools/$(schoolId)).data.isVerified == true);
        allow update, delete: if isCallerInSchool(schoolId) && isSchoolActive(schoolId);

        // Everything NESTED under a class document — attendance, subjects,
        // and subjects' own assignments/posts/submissions — is UNCHANGED:
        // the exact same broad same-school grant it always had under the
        // old single wildcard. Scoping these to per-class isolation too
        // would be a much larger frontend+rules change (every one of these
        // collections would need the same teacherIds/classId membership
        // check) and was not asked for in this pass. Each is matched by its
        // literal name rather than a recursive wildcard — see the NOTE
        // above for why a recursive wildcard doesn't work here.
        match /attendance/{attendanceId} {
          allow read, update, delete: if isCallerInSchool(schoolId) && isSchoolActive(schoolId);
          allow create: if (isCallerInSchool(schoolId) && isSchoolActive(schoolId)) ||
                           (!exists(/databases/$(database)/documents/schools/$(schoolId)) &&
                            existsAfter(/databases/$(database)/documents/schools/$(schoolId)) &&
                            getAfter(/databases/$(database)/documents/schools/$(schoolId)).data.isVerified == true);
        }

        match /subjects/{subjectId} {
          allow read, update, delete: if isCallerInSchool(schoolId) && isSchoolActive(schoolId);
          allow create: if (isCallerInSchool(schoolId) && isSchoolActive(schoolId)) ||
                           (!exists(/databases/$(database)/documents/schools/$(schoolId)) &&
                            existsAfter(/databases/$(database)/documents/schools/$(schoolId)) &&
                            getAfter(/databases/$(database)/documents/schools/$(schoolId)).data.isVerified == true);

          match /assignments/{assignmentId} {
            allow read, update, delete: if isCallerInSchool(schoolId) && isSchoolActive(schoolId);
            allow create: if (isCallerInSchool(schoolId) && isSchoolActive(schoolId)) ||
                             (!exists(/databases/$(database)/documents/schools/$(schoolId)) &&
                              existsAfter(/databases/$(database)/documents/schools/$(schoolId)) &&
                              getAfter(/databases/$(database)/documents/schools/$(schoolId)).data.isVerified == true);

            match /submissions/{studentId} {
              allow read, update, delete: if isCallerInSchool(schoolId) && isSchoolActive(schoolId);
              allow create: if (isCallerInSchool(schoolId) && isSchoolActive(schoolId)) ||
                               (!exists(/databases/$(database)/documents/schools/$(schoolId)) &&
                                existsAfter(/databases/$(database)/documents/schools/$(schoolId)) &&
                                getAfter(/databases/$(database)/documents/schools/$(schoolId)).data.isVerified == true);
            }
          }

          match /posts/{postId} {
            allow read, update, delete: if isCallerInSchool(schoolId) && isSchoolActive(schoolId);
            allow create: if (isCallerInSchool(schoolId) && isSchoolActive(schoolId)) ||
                             (!exists(/databases/$(database)/documents/schools/$(schoolId)) &&
                              existsAfter(/databases/$(database)/documents/schools/$(schoolId)) &&
                              getAfter(/databases/$(database)/documents/schools/$(schoolId)).data.isVerified == true);
          }
        }
      }

      // ConnectUs classroom data (classes, subjects, assignments — metadata
      // only, teaching_assignments, class-stream posts, exam metadata and
      // question prompts, class_sessions, attendance, behavior_points) is
      // intentionally covered by this wildcard: none of it is sensitive on
      // its own, and it inherits the same "school is active" gate everything
      // else here does. Nothing that must be hidden from a specific student
      // (a submission, an exam answer key) may ever be added anywhere under
      // schools/{schoolId} — this wildcard's grant is OR'd with any rule
      // written for a nested path, so a stricter rule placed here could never
      // actually restrict it. Those live under students/{studentId} (see
      // section 2a/2b above) or their own denied-by-default top-level
      // collection (see exam_answer_keys, section 11) instead.
      match /{subcollection=**} {
        // The entire 'classes' subtree (the class doc itself, and everything
        // nested under it) is handled by section 3a above instead — checking
        // subcollection[0] (index access, supported) rather than
        // subcollection.size() (NOT a supported method on this bound value —
        // see the note in section 3a) is enough to exclude all of it here,
        // since section 3a now explicitly matches every known nested
        // collection under classes/{classId} by name (attendance, subjects,
        // and subjects' own assignments/posts/submissions).
        //
        // READ/UPDATE/DELETE: caller identity + active school (Pass A).
        //                     isSchoolActive(schoolId) alone previously let
        //                     ANY caller — including an unauthenticated one,
        //                     since isSchoolActive never inspects request.auth
        //                     — read, edit, or delete subjects/
        //                     teaching_assignments/attendance/
        //                     behavior_points/semesters etc. belonging to ANY
        //                     active school, not just the caller's own.
        allow read, update, delete: if subcollection[0] != 'classes' &&
                                        isCallerInSchool(schoolId) && isSchoolActive(schoolId);

        // CREATE: same normal-path + scoped-bootstrap-path shape as the
        //         admins block above — see that block's comment for why
        //         !exists(...) is required to close the replay hole.
        allow create: if subcollection[0] != 'classes' && (
                          (isCallerInSchool(schoolId) && isSchoolActive(schoolId)) ||
                          (!exists(/databases/$(database)/documents/schools/$(schoolId)) &&
                           existsAfter(/databases/$(database)/documents/schools/$(schoolId)) &&
                           getAfter(/databases/$(database)/documents/schools/$(schoolId)).data.isVerified == true)
                        );
      }
    }

    // ── 4. Quote Requests & Onboarding ────────────────────────────────────
    match /quote_requests/{requestId} {
      // CREATE: public — landing.js quote form is unauthenticated.
      allow create: if true;

      // READ: unauthenticated onboarding reads its own quote by ID using the
      //       link from HQ email. HQ dashboard reads/lists all quotes.
      //       Keeping open because the quote ID is unguessable and list is
      //       only used by HQ (which has its own auth layer in the app).
      allow read: if true;

      // UPDATE: two legitimate paths —
      //   (a) HQ (platform_admin) manages quotes from the dashboard.
      //   (b) Unauthenticated onboarding.js marks the quote fulfilled and
      //       writes generatedSchoolId after creating the school. This is
      //       the ONLY field set onboarding is allowed to touch, and only
      //       while the quote is still unfulfilled.
      allow update: if (request.auth != null &&
                        request.auth.token.role == 'platform_admin') ||
                       (resource.data.fulfilled == false &&
                        request.resource.data.fulfilled == true &&
                        request.resource.data.diff(resource.data).affectedKeys()
                          .hasOnly(['fulfilled', 'generatedSchoolId']));

      // DELETE: disabled.
      allow delete: if false;
    }

    // ── 5. Subscription Plans (read-only from client) ─────────────────────
    match /subscriptionPlans/{planId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    // ── 6. Reset Vault (one-time PIN reset tokens) ────────────────────────
    // reset_vault does NOT store a Firebase Auth uid — it stores email,
    // userType, targetId, expiresAt. The reset-pin.html page reads and
    // deletes the token while the user is unauthenticated (that is the
    // entire point of a PIN reset). Token IDs are auto-generated and
    // unguessable; list is disabled so they cannot be enumerated.
    match /reset_vault/{tokenId} {
      allow get:    if true;
      allow list:   if false;
      allow create: if true;
      allow update: if false;
      allow delete: if true;
    }

    // ── 7. Platform Admins (ConnectUs HQ) ─────────────────────────────────
    // HQ dashboard (hq-team.js) reads, creates, updates, and deletes
    // platform_admin docs from the client using the HQ Firebase Auth session.
    // hq-login.js reads the doc after authenticating.
    // Restricted to HQ platform_admin tokens only — school users (teachers,
    // students, admins) authenticated via mintXToken cannot read or write.
    match /platform_admins/{adminId} {
      allow read, write: if request.auth != null &&
                            request.auth.token.role == 'platform_admin';
    }

    // ── 8. Organizations (Ministry of Ed, Districts, etc.) ────────────────
    // hq-organizations.js reads and writes from the HQ dashboard.
    // Restricted to HQ platform_admin tokens only.
    match /organizations/{orgId} {
      allow read, write: if request.auth != null &&
                            request.auth.token.role == 'platform_admin';
    }

    // ── 9. Payments / Revenue Logs ────────────────────────────────────────
    // hq-schools.js and hq-approvals.js create and read payment records
    // from the HQ dashboard. Restricted to HQ platform_admin tokens only.
    match /payments/{paymentId} {
      allow read, write: if request.auth != null &&
                            request.auth.token.role == 'platform_admin';
    }

    // ── 10. Registered Emails (duplicate check & account recovery) ────────
    // GET: must remain open — landing.js (unauthenticated quote form),
    //      onboarding.js (unauthenticated school creation), and
    //      forgot-pin.html all check email existence before any auth exists.
    // CREATE: open — onboarding.js (unauthenticated) creates during school
    //         setup; authenticated portals also create.
    // DELETE: authenticated only — admin/teacher/student settings delete
    //         the old entry when changing their email. Closing this from
    //         public prevents anonymous attackers from freeing email
    //         reservations to hijack them.
    // LIST: disabled — no code lists this collection.
    // UPDATE: disabled — entries are delete-and-recreate, never updated.
    match /registered_emails/{email} {
      allow get:    if true;
      allow create: if true;
      allow delete: if request.auth != null;
      allow list:   if false;
      allow update: if false;
    }

    // ── 11. Exam Answer Keys (ConnectUs Phase 2) ──────────────────────────
    // Correct answers for auto-graded exam questions. Deliberately its own
    // top-level collection, not nested under schools/{schoolId} (see the
    // comment in section 3) and not readable or writable by ANY client,
    // teacher or admin included — only the autoGradeObjectiveAnswers Cloud
    // Function, running with Admin SDK privileges that bypass these rules
    // entirely, ever touches this collection. A teacher builds and edits
    // the answer key through that same function, never a direct client write.
    match /exam_answer_keys/{examId} {
      allow read, write: if false;
    }

    // ── 12. Deny everything else ───────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
