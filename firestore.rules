rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── MASTER KILL SWITCH ─────────────────────────────────────────────────
    // Used by every rule that requires the school to be active and paying.
    function isSchoolActive(schoolId) {
      return exists(/databases/$(database)/documents/schools/$(schoolId)) &&
             get(/databases/$(database)/documents/schools/$(schoolId)).data.isVerified == true;
    }

    // ── PASS A: TENANT IDENTITY CHECK ───────────────────────────────────────
    // isSchoolActive() only ever checks the TARGET school's own doc — it never
    // looks at who is calling. That is the root cause of the cross-tenant gap
    // Pass A closes: any authenticated user at ANY active school (or, before
    // this pass, even an unauthenticated caller) could read/write another
    // active school's data, because isSchoolActive(schoolId) was the ONLY
    // gate. isCallerInSchool(schoolId) adds the missing identity check —
    // the caller's own token must carry the schoolId being accessed.
    function isCallerInSchool(schoolId) {
      return request.auth != null && request.auth.token.schoolId == schoolId;
    }

    // ── 1. National Teacher Registry ──────────────────────────────────────
    match /teachers/{teacherId} {
      // GET: teacher is active at a verified school, OR currentSchoolId is
      //      empty (claimed teacher search, restore flow).
      allow get: if resource.data.currentSchoolId == null
                 || resource.data.currentSchoolId == ''
                 || isSchoolActive(resource.data.currentSchoolId);

      // LIST: open — needed by admin portal, teacher portal, student portal,
      //       and HQ dashboard (all query with where() filters).
      allow list: if true;

      // CREATE: only when the school being assigned to is active.
      allow create: if isSchoolActive(request.resource.data.currentSchoolId);

      // UPDATE: school is active (normal operations), OR the doc currently
      //         has no school (restore from archive sets currentSchoolId back),
      //         OR the school being archived from is in archivedSchoolIds
      //         (allows the restore updateDoc to succeed).
      allow update: if resource.data.currentSchoolId == null
                    || resource.data.currentSchoolId == ''
                    || isSchoolActive(resource.data.currentSchoolId)
                    || (resource.data.archivedSchoolIds != null &&
                        request.auth != null &&
                        request.auth.token.schoolId in resource.data.archivedSchoolIds);

      // DELETE: disabled — soft deletes only.
      allow delete: if false;

      match /evaluations/{evalId} {
        allow read, create, update:
          if isSchoolActive(
            get(/databases/$(database)/documents/teachers/$(teacherId)).data.currentSchoolId
          );
        allow delete: if false;
      }
    }

    // ── 2. National Student Registry ──────────────────────────────────────
    match /students/{studentId} {
      // GET: student is at an active school, OR released/archived
      //      (currentSchoolId empty) — needed by student login (unauthenticated)
      //      and teacher claim search.
      allow get: if resource.data.currentSchoolId == null
                 || resource.data.currentSchoolId == ''
                 || isSchoolActive(resource.data.currentSchoolId);

      // LIST: open — needed by admin portal, teacher portal (roster, gradebook,
      //       reports, home, subjects), and HQ dashboard.
      allow list: if true;

      // CREATE: only when the school being assigned to is active.
      allow create: if isSchoolActive(request.resource.data.currentSchoolId);

      // UPDATE: school is active (normal), OR student is released/archived
      //         (currentSchoolId empty — restore, claim, student settings update).
      allow update: if resource.data.currentSchoolId == null
                    || resource.data.currentSchoolId == ''
                    || isSchoolActive(resource.data.currentSchoolId);

      // DELETE: teacher/archives.js permanentDeleteStudent hard-deletes the
      //         student doc. Must be authenticated AND the student is either
      //         at an active school or has no current school (released).
      allow delete: if request.auth != null &&
                       (resource.data.currentSchoolId == null ||
                        resource.data.currentSchoolId == '' ||
                        isSchoolActive(resource.data.currentSchoolId));

      match /grades/{gradeId} {
        // READ: school active OR student released (history.js reads grades
        //       for released students whose currentSchoolId is now empty).
        allow read: if get(/databases/$(database)/documents/students/$(studentId)).data.currentSchoolId == null
                    || get(/databases/$(database)/documents/students/$(studentId)).data.currentSchoolId == ''
                    || isSchoolActive(
                         get(/databases/$(database)/documents/students/$(studentId)).data.currentSchoolId
                       );

        // WRITE: school must be active (no grade entry after suspension).
        allow create, update: if isSchoolActive(
          get(/databases/$(database)/documents/students/$(studentId)).data.currentSchoolId
        );

        // DELETE: gradebook edit and permanentDeleteStudent both delete grades.
        allow delete: if isSchoolActive(
          get(/databases/$(database)/documents/students/$(studentId)).data.currentSchoolId
        ) || get(/databases/$(database)/documents/students/$(studentId)).data.currentSchoolId == null
          || get(/databases/$(database)/documents/students/$(studentId)).data.currentSchoolId == '';
      }

      match /evaluations/{evalId} {
        allow read, create, update:
          if isSchoolActive(
            get(/databases/$(database)/documents/students/$(studentId)).data.currentSchoolId
          );
        allow delete: if false;
      }

      // ── 2a. Assignment submissions (ConnectUs Phase 0) ───────────────────
      // Deliberately NOT nested under schools/{schoolId}/classes/.../assignments/.
      // Anything nested under schools/{schoolId} — at any depth — already
      // inherits the broad isSchoolActive()-only grant from the generic
      // schools/{schoolId}/{subcollection=**} wildcard below (section 3).
      // Firestore ORs together every rule that matches a given path, so a
      // stricter rule placed deeper inside that wildcard's reach can never
      // actually restrict access — the broad grant still applies regardless.
      // Living under the student registry instead (same reason grades and
      // evaluations already live here) lets a submission carry its own
      // rule that checks the caller's actual identity, not just whether
      // their school is active.
      match /submissions/{submissionId} {
        // READ: the school must be active, AND the caller is either the
        //       owning student or a teacher/admin at that same school.
        allow read: if isSchoolActive(
                        get(/databases/$(database)/documents/students/$(studentId)).data.currentSchoolId
                      ) &&
                      request.auth != null &&
                      (request.auth.token.studentId == studentId ||
                       (request.auth.token.role in ['teacher', 'super_admin', 'sub_admin'] &&
                        request.auth.token.schoolId ==
                          get(/databases/$(database)/documents/students/$(studentId)).data.currentSchoolId));

        // CREATE: only the owning student, only while their school is active.
        allow create: if isSchoolActive(
                          get(/databases/$(database)/documents/students/$(studentId)).data.currentSchoolId
                        ) &&
                        request.auth != null &&
                        request.auth.token.studentId == studentId;

        // UPDATE: the owning student may keep editing their own submission
        //         only while it isn't graded yet; a teacher/admin at that
        //         school may update it any time (grading, comments).
        allow update: if isSchoolActive(
                          get(/databases/$(database)/documents/students/$(studentId)).data.currentSchoolId
                        ) &&
                        request.auth != null &&
                        ((request.auth.token.studentId == studentId &&
                          resource.data.status != 'graded') ||
                         (request.auth.token.role in ['teacher', 'super_admin', 'sub_admin'] &&
                          request.auth.token.schoolId ==
                            get(/databases/$(database)/documents/students/$(studentId)).data.currentSchoolId));

        allow delete: if false;
      }

      // ── 2b. Exam submissions (ConnectUs Phase 2) ──────────────────────────
      // Same reasoning and same shape as assignment submissions above.
      match /exam_submissions/{examSubmissionId} {
        // GET (single-document read, e.g. a student loading their own
        // submission by ID): unchanged from the original combined rule —
        // this is a per-document check, so the get() lookup against
        // students/{studentId} is fine here. It is NOT fine for the list
        // rule below — see that rule's own comment for why.
        allow get: if isSchoolActive(
                        get(/databases/$(database)/documents/students/$(studentId)).data.currentSchoolId
                      ) &&
                      request.auth != null &&
                      (request.auth.token.studentId == studentId ||
                       (request.auth.token.role in ['teacher', 'super_admin', 'sub_admin'] &&
                        request.auth.token.schoolId ==
                          get(/databases/$(database)/documents/students/$(studentId)).data.currentSchoolId));

        // LIST (collection-group queries, e.g. the teacher live proctoring
        // dashboard querying every exam_submissions doc for one exam across
        // its whole class): NOT handled here. A rule nested inside
        // match /students/{studentId} { match /exam_submissions/{id} { ... } }
        // only ever governs the single, specific path
        // students/{studentId}/exam_submissions/{id} — it is never consulted
        // for a collectionGroup('exam_submissions') query, no matter what its
        // condition says. Firestore requires collection-group queries to be
        // matched by a rule declared with a recursive-wildcard prefix,
        // match /{path=**}/exam_submissions/{id} — see the standalone
        // top-level block of that exact shape further down this file
        // (search "COLLECTION-GROUP RULE — exam_submissions") for the actual
        // `allow list` rule and the full explanation of why it has to live
        // there instead of here.
        //
        // CREATE: disabled for every client, including the owning student.
        //         The submission doc must only ever be created by
        //         startExamAttempt (functions/index.js, an onCall function
        //         running with Admin SDK privileges that bypass these rules
        //         entirely) — that function is what computes serverDeadline
        //         from the SERVER's own clock. A direct client create() here
        //         would let a student set their own serverDeadline (or
        //         status, or examId/studentId mismatch) to whatever value
        //         they want, defeating the entire point of server-side time
        //         enforcement. Admin/teacher creation isn't needed either —
        //         nothing in this app has a teacher create a submission on a
        //         student's behalf.
        allow create: if false;

        // UPDATE: the owning student may keep writing their own answers
        //         (autosave) only while status is still 'in_progress' — the
        //         moment it becomes 'submitted' or any 'auto_submitted_*'
        //         value (set either by the student's own submit action or by
        //         the server-side timeout sweep — see
        //         docs/phase2-exams-architecture.md section 5, item 1), the
        //         student loses write access entirely, even if their own
        //         client is stale and still showing the exam as open. This is
        //         tighter than the original draft, which only locked the
        //         student out once status reached 'graded' — that left a
        //         window where a student could keep "saving" answers after
        //         their own submission (or a server-side auto-submit) had
        //         already finalized. `status` itself may never move BACKWARD
        //         out of a terminal state via a student write — enforced
        //         implicitly by only granting the student branch when the
        //         CURRENT (resource.data) status is still 'in_progress'.
        //
        //         Every grading field — score, pendingManualPoints,
        //         pendingManualQuestionIds, manualGrades, gradedAt, gradedBy
        //         — is explicitly forbidden from the student's diff, on top
        //         of the pre-existing serverDeadline guard (ConnectUs Phase
        //         3 — Grading & Results). This isn't just "the student
        //         shouldn't write these" as a UI convention: autoGradeObjective
        //         Answers and recordManualGrade (functions/index.js, both
        //         Admin SDK, both bypass these rules) are the ONLY intended
        //         writers of these fields, so a student write that happens
        //         to touch any of them — even as a side effect of some other
        //         intended change — must be rejected outright, not merged.
        //
        //         NO teacher/admin branch exists here anymore. Every
        //         legitimate teacher-side write to a submission (manual
        //         grading) now goes through recordManualGrade, an onCall
        //         function that runs under the Admin SDK and enforces its
        //         own points-range and no-double-grading checks — see that
        //         function's own comment for why those checks belong in
        //         server code, not client-trusted rules, the same reasoning
        //         already applied to startExamAttempt's serverDeadline.
        //         Removing the teacher branch here (rather than merely
        //         restricting its allowed fields) is deliberate: a rules
        //         allowlist of "teachers may touch these fields but not
        //         those" is one missed field away from reopening exactly the
        //         bypass this design is meant to close, whereas "teachers
        //         have no client update path at all" cannot be partially
        //         gotten wrong. A teacher's read access is unaffected — the
        //         `allow get` rule above still applies.
        allow update: if isSchoolActive(
                          get(/databases/$(database)/documents/students/$(studentId)).data.currentSchoolId
                        ) &&
                        request.auth != null &&
                        request.auth.token.studentId == studentId &&
                        resource.data.status == 'in_progress' &&
                        // The student's own client makes two different kinds
                        // of write while in_progress: repeated autosaves that
                        // never touch `status` at all (it stays 'in_progress'
                        // after the merge), and exactly one final submit that
                        // moves it to 'submitted' (take.js's submitExam(),
                        // verified end-to-end in Phase 2 testing). Both are
                        // legitimate; what's never legitimate from a student
                        // write is landing on 'graded' or any
                        // 'auto_submitted_*' value — those come only from
                        // recordManualGrade and the server-side timeout sweep,
                        // respectively. So this is an allowlist of the two
                        // destination statuses a student write may produce,
                        // not a blocklist of 'graded' alone.
                        request.resource.data.status in ['in_progress', 'submitted'] &&
                        !('score' in request.resource.data.diff(resource.data).affectedKeys()) &&
                        !('serverDeadline' in request.resource.data.diff(resource.data).affectedKeys()) &&
                        !('pendingManualPoints' in request.resource.data.diff(resource.data).affectedKeys()) &&
                        !('pendingManualQuestionIds' in request.resource.data.diff(resource.data).affectedKeys()) &&
                        !('manualGrades' in request.resource.data.diff(resource.data).affectedKeys()) &&
                        !('gradedAt' in request.resource.data.diff(resource.data).affectedKeys()) &&
                        !('gradedBy' in request.resource.data.diff(resource.data).affectedKeys());

        allow delete: if false;
      }

      // ── 2c. Attendance (fan-out target — Phase 1 Milestone 6 privacy fix) ──
      // Each doc here is written ONLY by the onAttendanceSaved Cloud Function
      // via the Admin SDK, which bypasses these rules entirely — that is the
      // whole point: it lets the function populate this path even though
      // `allow write: if false` below denies every client write, including
      // the owning student's own. The class-day source document
      // (schools/{schoolId}/classes/{classId}/attendance/{date}) can only
      // ever be read by admins/teachers now (see that match block above);
      // this is the ONLY path a student can read their own attendance from,
      // and a rule scoped to a single document like this can safely grant
      // that without ever exposing a classmate's status alongside it.
      match /attendance/{attDate} {
        allow read: if request.auth != null &&
                       request.auth.token.studentId == studentId &&
                       (get(/databases/$(database)/documents/students/$(studentId)).data.currentSchoolId == null ||
                        get(/databases/$(database)/documents/students/$(studentId)).data.currentSchoolId == '' ||
                        isSchoolActive(
                          get(/databases/$(database)/documents/students/$(studentId)).data.currentSchoolId
                        ));

        allow write: if false;
      }
    }

    // ── 2d. COLLECTION-GROUP RULE — exam_submissions ───────────────────────
    // This is a SEPARATE, top-level match block from the nested
    // students/{studentId}/exam_submissions/{examSubmissionId} rules in
    // section 2b above — and it has to be. A rule nested inside
    // match /students/{studentId} { match /exam_submissions/{id} { ... } }
    // only ever governs the single, specific document path
    // students/{studentId}/exam_submissions/{id}; it is NEVER consulted for
    // a collectionGroup('exam_submissions') query, regardless of what its
    // condition says. Firestore requires collection-group queries to be
    // matched by a rule declared with a recursive-wildcard prefix —
    // match /{path=**}/exam_submissions/{id} — per Firebase's own docs
    // (firebase.google.com/docs/firestore/security/rules-structure: "If you
    // use collection group queries, you must use version 2" [rules_version
    // = '2' at the top of this file] and rules-query's own worked example,
    // match /{path=**}/songs/{song}). Without a block in exactly this shape,
    // a collectionGroup('exam_submissions') query — teacher/exams/live.js's
    // live proctoring dashboard, querying every exam_submissions doc for one
    // exam across a whole class in one listener — is rejected outright
    // (permission-denied on the whole query, falling through to this file's
    // final deny-all match /{document=**} block), even when the query's own
    // where() clauses exactly match this rule's conditions, and even
    // against an EMPTY result set: this is a structural reachability
    // problem, not a condition ever being evaluated and found false.
    //
    // The condition itself matches section 2b's original design intent: a
    // teacher/admin at the same active school as the document, proven from
    // resource.data fields alone (never a get()/exists() call — see 2b's
    // own comment on why any get() inside a list rule is independently fatal
    // to the "queries are all or nothing" proof, on top of this reachability
    // issue). schoolId and isSchoolActive are both denormalized onto every
    // exam_submissions doc by startExamAttempt at create time (see
    // functions/index.js) specifically so this rule — and the caller's
    // matching where('schoolId', ...) / where('isSchoolActive', ...)
    // clauses in live.js — never need one.
    //
    // Students never list this collection group themselves (they only ever
    // get() their own single submission by ID via startExamAttempt's return
    // value, which is still governed by section 2b's nested `allow get`
    // rule, unaffected by this block) — so this rule is teacher/admin-only.
    match /{path=**}/exam_submissions/{examSubmissionId} {
      allow list: if request.auth != null &&
                     request.auth.token.role in ['teacher', 'super_admin', 'sub_admin'] &&
                     resource.data.isSchoolActive == true &&
                     resource.data.schoolId == request.auth.token.schoolId;
    }

    // ── 2e. COLLECTION-GROUP RULE — live_sessions/{id}/responses ───────────
    // Same structural need as the exam_submissions collection-group rule
    // directly above: the nested `match /responses/{responseId}` block under
    // lessons/{lessonId}/live_sessions/{sessionId} (see section on Lessons,
    // above) only ever governs a single, fully-specified document path — it
    // is NEVER consulted for the teacher live dashboard's
    // onSnapshot(collection(...'/responses')) listener, which lists every
    // response in one session at once. That requires its own top-level rule
    // declared with a recursive-wildcard prefix, exactly like
    // exam_submissions above (see that rule's own comment for the full
    // "queries are all or nothing" explanation — same reasoning applies here
    // verbatim, just for a different collection).
    //
    // schoolId is denormalized onto every response doc by saveLiveResponse()
    // (lessons.js) specifically so this rule never needs a get() lookup —
    // a list rule that calls get()/exists() anywhere in its evaluation can't
    // be proven safe for a list/collection-group query and gets rejected
    // outright, same as exam_submissions.
    //
    // CORRECTED after live end-to-end testing: this was originally
    // teacher/admin-only, on the assumption students never list this
    // collection group. That assumption was wrong — collaborative_board is
    // explicitly Padlet-style (every connected student's card is visible to
    // the WHOLE CLASS, not just the teacher), so viewer.js's own
    // registerBlockResponsesListener() opens exactly this same
    // onSnapshot(collection(...)) listener on the student side too, to
    // render the shared wall.
    //
    // A first fix just added a same-school student grant across the board,
    // but that over-corrected: interactive_prompt is explicitly PRIVATE
    // (Nearpod-style — a student's answer is never shown to classmates),
    // and a blanket same-school list grant would let any student read every
    // other student's private prompt answers directly via the SDK, even
    // though viewer.js's own UI chooses not to render that wall — a
    // client-side rendering choice was never a real security boundary.
    // blockType (denormalized onto every response doc by saveLiveResponse(),
    // same reason schoolId is) is what lets this rule tell the two block
    // types apart without a get() lookup: a student may only list responses
    // for a collaborative_board block (the one block type actually meant to
    // be shared); teacher/admin keep unrestricted access to every response,
    // interactive_prompt included, since only a teacher needs to see
    // individual students' private prompt answers.
    match /{path=**}/live_sessions/{sessionId}/responses/{responseId} {
      allow list: if request.auth != null &&
                     resource.data.schoolId == request.auth.token.schoolId && (
                       request.auth.token.role in ['teacher', 'super_admin', 'sub_admin'] ||
                       resource.data.blockType == 'collaborative_board'
                     );
    }

    // ── 2f. National Parent Registry (Phase 3 Step 1) ───────────────────────
    // A parent can have children at more than one school, so — unlike
    // teachers/students — there is no single schoolId to scope this
    // collection by. Everything sensitive here (email lookup/dedup, PIN
    // hashing, custom-token minting) runs server-side via linkOrCreateParent/
    // mintParentToken (functions/index.js, Admin SDK — rules never apply to
    // those calls). Client SDK access is therefore locked to self-read-only,
    // exactly mirroring how mintTeacherToken/mintStudentToken already keep
    // all credential-critical writes off the client.
    match /parents/{parentId} {
      // GET: a parent may read only their own document, once mintParentToken
      // has logged them in (auth.uid == parentId, since mintToken(parentId, …)
      // is what mints their custom token — same pattern as teachers/students).
      allow get: if request.auth != null &&
                    (request.auth.uid == parentId || request.auth.token.parentId == parentId);

      // No client LIST (would leak every parent's email/phone/which-children-
      // at-which-school to any authenticated caller — a bigger, cross-tenant
      // PII surface than the teacher/student national registries carry), and
      // no client CREATE/UPDATE/DELETE — parent lifecycle is Cloud-Function-only.
      allow list, create, update, delete: if false;
    }

    // ── 2g. Parent email → Parent ID index (Phase 3 Step 1) ─────────────────
    // Purely an internal, Admin-SDK-only index used by linkOrCreateParent's
    // Firestore transaction to make "find-or-create a parent by email"
    // race-free (two concurrent creations for the same brand-new email must
    // never mint two different Parent IDs). Never read or written by any
    // client SDK, and never exposed via a token claim — deny everything
    // (the trailing match /{document=**} at the bottom of this file would
    // already deny it by default with no rule at all, but this is written
    // out explicitly, same as every other sensitive collection in this file).
    match /parent_emails/{normalizedEmail} {
      allow read, write: if false;
    }

    // ── 3. Siloed School Data ──────────────────────────────────────────────
    match /schools/{schoolId} {
      // GET/LIST: public — needed by login pages, student portal, teacher
      //           portal (all read school doc without school-specific auth).
      allow get, list: if true;

      // CREATE: onboarding.js creates the school doc during signup.
      //         The user is unauthenticated at that point (no school session
      //         yet), so this must remain open. The onboarding page is only
      //         reachable via a one-time signed link from HQ.
      allow create: if true;

      // UPDATE: three legitimate paths —
      //   (a) The school's own super_admin via their verified session.
      //       mintAdminToken issues tokens with the schoolId claim, so this
      //       also covers first-time setup right after login.
      //   (b) An HQ platform_admin (HQ dashboard, hq-schools.js).
      //   (c) Unauthenticated PIN reset from reset-pin.html — only allowed
      //       to touch the PIN reset fields. The reset_vault token (which is
      //       short-lived and unguessable) gates access to the page itself.
      //       Limiting affectedKeys to the three reset fields ensures an
      //       attacker without the token cannot modify isVerified, limits,
      //       contactEmail, or any other field.
      allow update: if (request.auth != null &&
                        request.auth.token.schoolId == schoolId) ||
                       (request.auth != null &&
                        request.auth.token.role == 'platform_admin') ||
                       (request.resource.data.diff(resource.data).affectedKeys()
                          .hasOnly(['adminCode', 'requiresPinReset', 'lastPinResetAt']));

      // DELETE: disabled.
      allow delete: if false;

      match /admins/{adminId} {
        // READ/UPDATE: the caller must belong to THIS school (identity check)
        //              AND the school must be active. Previously isSchoolActive
        //              alone meant any active-school caller — or, per the
        //              subcollection wildcard nested below, potentially an
        //              unauthenticated one — could read/edit another school's
        //              admin records.
        allow read, update: if isCallerInSchool(schoolId) && isSchoolActive(schoolId);

        // CREATE: normal path requires caller identity + active school.
        //         Bootstrap path (onboarding.js's atomic writeBatch creating
        //         the school doc and its first records together) is scoped
        //         with !exists(...) so it only ever fires the FIRST time a
        //         school is created — existsAfter()/getAfter() alone describe
        //         only the state AFTER this write, which is equally true for
        //         a replay against an already-existing verified school. Pass
        //         A patches that replay hole.
        allow create: if (isCallerInSchool(schoolId) && isSchoolActive(schoolId)) ||
                         (!exists(/databases/$(database)/documents/schools/$(schoolId)) &&
                          existsAfter(/databases/$(database)/documents/schools/$(schoolId)) &&
                          getAfter(/databases/$(database)/documents/schools/$(schoolId)).data.isVerified == true);

        // DELETE: unchanged — already denied to everyone (soft-delete only
        //         model, same as teachers/students/schools). Nothing to
        //         tighten: `false` cannot be made more restrictive.
        allow delete: if false;

        match /{subcollection=**} {
          allow read, update: if isCallerInSchool(schoolId) && isSchoolActive(schoolId);
          allow create: if (isCallerInSchool(schoolId) && isSchoolActive(schoolId)) ||
                           (!exists(/databases/$(database)/documents/schools/$(schoolId)) &&
                            existsAfter(/databases/$(database)/documents/schools/$(schoolId)) &&
                            getAfter(/databases/$(database)/documents/schools/$(schoolId)).data.isVerified == true);
          allow delete: if false;
        }
      }

      // ── Semesters / teaching_assignments: carved out of the generic
      // wildcard below (Discovered during 2026-09-11 post-deploy testing —
      // NOT part of the original Pass A/B design, a real gap found live).
      //
      // Cloud Firestore does not grant `list` through a rule written on a
      // recursive wildcard (`{subcollection=**}` below) — only `get` on a
      // specific document ID. A `list`/unfiltered `getDocs(collection(...))`
      // query against a path ONLY covered by that wildcard is silently
      // denied ("Missing or insufficient permissions"), even though the
      // exact same boolean condition (isCallerInSchool && isSchoolActive)
      // evaluates true for a `get` on one of its documents. Confirmed live:
      // schools/{schoolId}/admins (has its own named match block, like this
      // one) lists fine; schools/{schoolId}/semesters and
      // .../teaching_assignments (previously relying solely on the generic
      // wildcard) both 403'd on every list call — admin dashboard,
      // gradebook, report cards, grade weighting, roster, grading period
      // management, student/teacher portals — while a direct getDoc() on
      // the same path succeeded. Named match blocks (see /admins and
      // /classes above) were never affected; only paths left to the
      // recursive wildcard were. Fixed the same way Pass B fixed /classes:
      // named single-segment matches instead of relying on the wildcard.
      match /semesters/{semesterId} {
        allow read, update: if isCallerInSchool(schoolId) && isSchoolActive(schoolId);
        allow create: if (isCallerInSchool(schoolId) && isSchoolActive(schoolId)) ||
                         (!exists(/databases/$(database)/documents/schools/$(schoolId)) &&
                          existsAfter(/databases/$(database)/documents/schools/$(schoolId)) &&
                          getAfter(/databases/$(database)/documents/schools/$(schoolId)).data.isVerified == true);
        allow delete: if false;
      }

      match /teaching_assignments/{teachingAssignmentId} {
        allow read, update: if isCallerInSchool(schoolId) && isSchoolActive(schoolId);
        allow create: if (isCallerInSchool(schoolId) && isSchoolActive(schoolId)) ||
                         (!exists(/databases/$(database)/documents/schools/$(schoolId)) &&
                          existsAfter(/databases/$(database)/documents/schools/$(schoolId)) &&
                          getAfter(/databases/$(database)/documents/schools/$(schoolId)).data.isVerified == true);
        allow delete: if false;
      }

      // ── 3a. Classes: Per-Class Isolation (PASS B, PART 2) ─────────────────
      // schools/{schoolId}/classes/{classId} — the class document itself —
      // is carved out of the generic wildcard below and given a stricter GET
      // grant. Pass A's isCallerInSchool(schoolId) proves the caller belongs
      // to THIS SCHOOL, but says nothing about which CLASS they belong to:
      // under Pass A alone, any teacher or student at an active school could
      // still read every OTHER class's document at that same school, even
      // one they have no relationship to. Per-class isolation adds that
      // missing check via a get() lookup on the resource the caller is
      // claiming membership in (teacherIds, for a teacher) or on the
      // caller's OWN doc (a student's classId lives on their student doc,
      // not on their auth token).
      //
      // NOTE on two earlier, broken attempts at this block, kept here so the
      // reasoning isn't re-litigated later:
      //   1. Guarding the sibling wildcard below with a
      //      `subcollection.size() == 2` check, to distinguish the bare
      //      class doc from paths nested under it. The real emulator
      //      rejected this at runtime — "Function not found error: Name:
      //      [size]" — a recursive wildcard's bound value supports index
      //      access (path[0]) but not a .size()/.length method here.
      //   2. Replacing that with a nested `match /{deeperPath=**}` directly
      //      under /classes/{classId}, on the theory that a nested match
      //      can only ever compose onto something STRICTLY DEEPER than its
      //      parent. That's wrong: a recursive wildcard matches ZERO OR MORE
      //      segments, so {deeperPath=**} ALSO matched the bare class doc
      //      itself (deeperPath == []) — its broad read grant then OR'd
      //      with the stricter GET rule below and silently defeated the
      //      isolation (confirmed by Justine's test run: a teacher could
      //      still read another teacher's class).
      // Fixed by dropping recursive wildcards entirely for this subtree and
      // explicitly matching each known nested collection by name instead
      // (subjects, attendance, and subjects' own assignments/posts/
      // submissions — the complete set actually used anywhere in this
      // codebase, confirmed by grep). A named single-segment match like
      // `match /subjects/{subjectId}` has no zero-segment case — it requires
      // that literal segment to be present — so there is no ambiguity left.
      match /classes/{classId} {
        // GET: three ways in —
        //   (a) an admin (super_admin/sub_admin) at this school — unrestricted,
        //       same as every other admin read in this file.
        //   (b) a teacher whose own teacherId appears in THIS class's
        //       teacherIds array (resource.data — the class doc being read).
        //   (c) a student whose OWN classId (fetched via get() on their
        //       student doc, since the token only carries studentId) matches
        //       THIS classId.
        // A teacher assigned to a different class, or a student enrolled in
        // a different class, satisfies isCallerInSchool(schoolId) but fails
        // all three checks above and is correctly denied — this is the
        // isolation Pass A's school-level check didn't provide.
        allow get: if isCallerInSchool(schoolId) && isSchoolActive(schoolId) && (
          request.auth.token.role in ['super_admin', 'sub_admin'] ||
          (request.auth.token.role == 'teacher' &&
           request.auth.token.teacherId in resource.data.teacherIds) ||
          (request.auth.token.role == 'student' &&
           get(/databases/$(database)/documents/students/$(request.auth.token.studentId)).data.classId == classId)
        );

        // LIST/CREATE/UPDATE/DELETE on the class doc itself: intentionally
        //       left at the same isCallerInSchool(schoolId) &&
        //       isSchoolActive(schoolId) grant as before (identical to the
        //       generic wildcard this block is carved out of). admin/
        //       classes.js, admin/teachers.js, admin/students.js, admin/
        //       reports.js, teacher/roster.js, and assets/js/utils.js all
        //       fetch the FULL unfiltered classes collection today and
        //       filter client-side; narrowing LIST to a per-caller query
        //       would require rewriting every one of those call sites to a
        //       server-verifiable where() clause, which is a frontend change
        //       outside this pass's ask (per-class GET isolation). Nothing
        //       in the current codebase has a teacher or student directly
        //       create/update/delete a class document, so leaving those at
        //       the broader same-school grant carries no practical risk
        //       today — tightening them to admin-only is a reasonable
        //       future hardening step, flagged here rather than done
        //       silently since it wasn't asked for in this pass.
        allow list: if isCallerInSchool(schoolId) && isSchoolActive(schoolId);
        allow create: if (isCallerInSchool(schoolId) && isSchoolActive(schoolId)) ||
                         (!exists(/databases/$(database)/documents/schools/$(schoolId)) &&
                          existsAfter(/databases/$(database)/documents/schools/$(schoolId)) &&
                          getAfter(/databases/$(database)/documents/schools/$(schoolId)).data.isVerified == true);
        allow update, delete: if isCallerInSchool(schoolId) && isSchoolActive(schoolId);

        // Everything NESTED under a class document EXCEPT attendance —
        // subjects, and subjects' own assignments/posts/submissions — is
        // UNCHANGED: the exact same broad same-school grant it always had
        // under the old single wildcard. Scoping those to per-class
        // isolation too would be a much larger frontend+rules change (every
        // one of these collections would need the same teacherIds/classId
        // membership check) and was not asked for in this pass. Each is
        // matched by its literal name rather than a recursive wildcard —
        // see the NOTE above for why a recursive wildcard doesn't work here.
        //
        // attendance IS scoped, as of this pass — mirroring section 3a's
        // GET rule on the class doc itself exactly:
        //   READ: admin (unrestricted) OR teacher assigned to THIS class
        //         (teacherIds, looked up via get() on the class doc, since
        //         resource here is the attendance doc, not the class doc)
        //         OR student whose OWN classId (looked up via get() on
        //         their student doc) matches THIS class.
        //   WRITE (create/update/delete): admin OR the specific teacher(s)
        //         assigned to THIS class — never a student, regardless of
        //         the read grant above. This closes a real gap: the prior
        //         version granted read AND write to any same-school caller,
        //         which let a student create/edit/delete their own
        //         attendance record even though the UI never exposed a way
        //         to do so. The backend rule now enforces what the UI
        //         already implied (student/attendance is read-only;
        //         teacher/attendance is the only write flow) instead of
        //         relying on the UI alone.
        //
        // ── PRIVACY FIX (fan-out) ──────────────────────────────────────────
        // Students are now DENIED read access to this document entirely.
        // Reason: this document's `records` field is a map keyed by every
        // student in the class, and Firestore security rules can only grant
        // or deny access to a document as a WHOLE — there is no way to write
        // a rule that lets one student read only their own key inside this
        // map. Any rule that let an enrolled student read this document at
        // all handed back every classmate's attendance status too. This was
        // confirmed directly: a raw Firestore SDK read of this document as
        // an authenticated student returned the full `records` map for every
        // student in the class, even though the student-facing UI happened
        // to filter its display down to just that student's own row.
        //
        // The real fix lives elsewhere: onAttendanceSaved (functions/index.js)
        // fans this document out, via the Admin SDK (which bypasses these
        // rules), into a genuinely per-student document at
        // students/{studentId}/attendance/{date} — see the match block for
        // that path under students/{studentId} below. Students now read
        // ONLY that fanned-out path; this class-day document is admin/
        // teacher-only for both read and write.
        match /attendance/{attendanceId} {
          allow read: if isCallerInSchool(schoolId) && isSchoolActive(schoolId) && (
            request.auth.token.role in ['super_admin', 'sub_admin'] ||
            (request.auth.token.role == 'teacher' &&
             request.auth.token.teacherId in
               get(/databases/$(database)/documents/schools/$(schoolId)/classes/$(classId)).data.teacherIds)
          );

          allow update, delete: if isCallerInSchool(schoolId) && isSchoolActive(schoolId) && (
            request.auth.token.role in ['super_admin', 'sub_admin'] ||
            (request.auth.token.role == 'teacher' &&
             request.auth.token.teacherId in
               get(/databases/$(database)/documents/schools/$(schoolId)/classes/$(classId)).data.teacherIds)
          );

          allow create: if (
            isCallerInSchool(schoolId) && isSchoolActive(schoolId) && (
              request.auth.token.role in ['super_admin', 'sub_admin'] ||
              (request.auth.token.role == 'teacher' &&
               request.auth.token.teacherId in
                 get(/databases/$(database)/documents/schools/$(schoolId)/classes/$(classId)).data.teacherIds)
            )
          ) || (
            !exists(/databases/$(database)/documents/schools/$(schoolId)) &&
            existsAfter(/databases/$(database)/documents/schools/$(schoolId)) &&
            getAfter(/databases/$(database)/documents/schools/$(schoolId)).data.isVerified == true
          );
        }

        match /subjects/{subjectId} {
          allow read, update, delete: if isCallerInSchool(schoolId) && isSchoolActive(schoolId);
          allow create: if (isCallerInSchool(schoolId) && isSchoolActive(schoolId)) ||
                           (!exists(/databases/$(database)/documents/schools/$(schoolId)) &&
                            existsAfter(/databases/$(database)/documents/schools/$(schoolId)) &&
                            getAfter(/databases/$(database)/documents/schools/$(schoolId)).data.isVerified == true);

          match /assignments/{assignmentId} {
            allow read, update, delete: if isCallerInSchool(schoolId) && isSchoolActive(schoolId);
            allow create: if (isCallerInSchool(schoolId) && isSchoolActive(schoolId)) ||
                             (!exists(/databases/$(database)/documents/schools/$(schoolId)) &&
                              existsAfter(/databases/$(database)/documents/schools/$(schoolId)) &&
                              getAfter(/databases/$(database)/documents/schools/$(schoolId)).data.isVerified == true);

            match /submissions/{studentId} {
              allow read, update, delete: if isCallerInSchool(schoolId) && isSchoolActive(schoolId);
              allow create: if (isCallerInSchool(schoolId) && isSchoolActive(schoolId)) ||
                               (!exists(/databases/$(database)/documents/schools/$(schoolId)) &&
                                existsAfter(/databases/$(database)/documents/schools/$(schoolId)) &&
                                getAfter(/databases/$(database)/documents/schools/$(schoolId)).data.isVerified == true);
            }
          }

          match /posts/{postId} {
            allow read, update, delete: if isCallerInSchool(schoolId) && isSchoolActive(schoolId);
            allow create: if (isCallerInSchool(schoolId) && isSchoolActive(schoolId)) ||
                             (!exists(/databases/$(database)/documents/schools/$(schoolId)) &&
                              existsAfter(/databases/$(database)/documents/schools/$(schoolId)) &&
                              getAfter(/databases/$(database)/documents/schools/$(schoolId)).data.isVerified == true);
          }

          // ── Lessons (Interactive Slide Decks) ─────────────────────────────
          // Named nested match, same reason as assignments/posts above: this
          // subtree carved named matches out of the old recursive-wildcard
          // fallback (see the NOTE on section 3a), so a new collection here
          // MUST be named explicitly or it is simply unreachable — every
          // read/write on it would fall through to the final deny-all.
          //
          // READ: two tiers, unlike assignments/posts' single same-school
          //       grant, because a lesson has a real draft/published gate a
          //       student must never bypass by guessing/enumerating IDs:
          //         (a) teacher/admin at this school — unrestricted (same
          //             grant as assignments/posts), so the builder can list
          //             and open a lesson's own drafts.
          //         (b) a student (or any other same-school caller) — ONLY
          //             if the lesson's own status field is 'published'.
          //             request.auth.token.role doesn't need to be checked
          //             on this branch: isCallerInSchool already requires a
          //             valid token, and a draft lesson is denied to every
          //             role but teacher/admin regardless of who is asking.
          // CREATE/UPDATE/DELETE: teacher/admin only — a student has no
          //       legitimate write path to a lesson document at all (unlike
          //       assignments/posts, which allow the broader same-school
          //       grant; nothing today has a student write those either, but
          //       lessons is new enough to start it correctly rather than
          //       carry the looser legacy grant forward).
          match /lessons/{lessonId} {
            allow read: if isCallerInSchool(schoolId) && isSchoolActive(schoolId) && (
              request.auth.token.role in ['teacher', 'super_admin', 'sub_admin'] ||
              resource.data.status == 'published'
            );

            allow create, update, delete: if isCallerInSchool(schoolId) && isSchoolActive(schoolId) &&
                                              request.auth.token.role in ['teacher', 'super_admin', 'sub_admin'];

            // ── Teacher-only pacing notes / standards ───────────────────────
            // Firestore rules cannot filter individual FIELDS within a
            // document — only grant or deny the document as a whole (see the
            // class-level attendance comment above, section 3a, for the
            // exact same limitation hit and fixed the same way for a
            // different collection). pacingNotes/standards therefore live in
            // their OWN document, nested here, rather than as fields on the
            // main lesson doc above — so they can be denied to students
            // outright rather than merely hidden by client-side code (which
            // any student could bypass with a raw SDK read, exactly as that
            // earlier comment describes for the attendance fan-out gap).
            //
            // Students are NEVER granted read here, published or not — this
            // is intentionally NOT symmetric with the main lesson doc's
            // published-status carve-out above.
            match /private/{docId} {
              allow read, create, update, delete: if isCallerInSchool(schoolId) && isSchoolActive(schoolId) &&
                                                      request.auth.token.role in ['teacher', 'super_admin', 'sub_admin'];
            }

            // ── PHASE 3: LIVE SESSION ENGINE ──────────────────────────────
            // The session doc itself (activeLessonId/teacherPositionId/
            // startedAt/endedAt — never the responses, which are a separate
            // subcollection matched below). READ is the same same-school
            // grant every student already gets on assignments/posts (no
            // per-student data lives on this doc, so no narrower isolation
            // is needed) — a student must be able to onSnapshot this doc to
            // auto-follow the teacher's live position at all. WRITE is
            // teacher/admin only: a student able to set teacherPositionId
            // could desync every other student's screen, and a student able
            // to set endedAt could kill the session for the whole class.
            match /live_sessions/{sessionId} {
              allow read: if isCallerInSchool(schoolId) && isSchoolActive(schoolId);
              allow create, update, delete: if isCallerInSchool(schoolId) && isSchoolActive(schoolId) &&
                                                request.auth.token.role in ['teacher', 'super_admin', 'sub_admin'];

              // GET (a single student's own response, or a teacher/admin
              // reading one document by id): fine as a per-document get()
              // rule — costs nothing extra for the "queries are all or
              // nothing" reachability problem the LIST rule below has to
              // solve separately, exactly like exam_submissions's own GET
              // vs LIST split (see that match block's comments above).
              //
              // WRITE: a student may only ever create/update the response
              // DOC THEY OWN. responseId.split('_')[0] alone is NOT enough
              // to prove that — blockId (genSlideId()'s own output) always
              // contains underscores itself, so responseId.split('_')[0]
              // only ever recovers the studentId half correctly; it proves
              // nothing about the REST of the id. Checking only that half
              // would let a student pick any doc id starting with
              // "<their own studentId>_" and write an arbitrary document
              // under it — flooding this session's responses subcollection
              // with junk (a cost/DoS issue on the teacher's live grid), or
              // writing into a blockId they never actually answered by
              // constructing "<their studentId>_<someone else's blockId>".
              // The fix: require the FULL doc id to equal exactly
              // "<studentId>_<blockId>" built from the WRITTEN document's
              // own fields (request.resource.data), not just its prefix —
              // this pins both halves of the id to real, validated fields
              // rather than trusting client-supplied path segments alone.
              match /responses/{responseId} {
                allow get: if isCallerInSchool(schoolId) && isSchoolActive(schoolId) && (
                  request.auth.token.role in ['teacher', 'super_admin', 'sub_admin'] ||
                  request.auth.token.studentId == responseId.split('_')[0]
                );

                // LIST: needed on top of the collection-group rule above
                // (section 2e) — that rule only ever governs a
                // collectionGroup('responses') query. lessons.js's
                // subscribeToLiveResponses() does NOT do a collection-group
                // query; it opens a plain onSnapshot(collection(...)) scoped
                // to this exact nested path (schools/.../lessons/{lessonId}/
                // live_sessions/{sessionId}/responses), which is a `list`
                // against THIS match block, not the collection-group one.
                // Without an explicit `allow list` here, that listener was
                // denied outright for every caller, teacher included — found
                // via live end-to-end testing.
                //
                // CORRECTED (second live-test pass): a first attempt at this
                // rule gated on isCallerInSchool(schoolId) && isSchoolActive
                // (schoolId), same as every other rule in this nested match
                // block. That's wrong specifically for a LIST rule —
                // isSchoolActive() calls get()/exists(), and per this file's
                // own "queries are all or nothing" reasoning (see section 2b/
                // 2d/2e's comments on why the exam_submissions and
                // live_sessions/responses COLLECTION-GROUP rules never call
                // get()/exists()), ANY get()/exists() call anywhere in a list
                // rule's evaluation makes the whole query unprovable and
                // Firestore denies it outright — confirmed live: a raw
                // getDocs() on this exact path was denied even though the
                // role/blockType logic below was already correct. GET/CREATE/
                // UPDATE above are unaffected (per-document rules can call
                // get() safely — that's a single lookup for a specific
                // resource, not a query Firestore has to prove ahead of time),
                // so only this LIST rule needed to change. Fixed the same way
                // section 2e's collection-group rule already does it:
                // schoolId is denormalized onto every response doc by
                // saveLiveResponse() (lessons.js) specifically so this check
                // never needs a get() lookup — compare resource.data.schoolId
                // directly against the caller's own token instead.
                allow list: if request.auth != null &&
                               resource.data.schoolId == request.auth.token.schoolId && (
                                 request.auth.token.role in ['teacher', 'super_admin', 'sub_admin'] ||
                                 resource.data.blockType == 'collaborative_board'
                               );

                allow create, update: if isCallerInSchool(schoolId) && isSchoolActive(schoolId) &&
                                          request.auth.token.role == 'student' &&
                                          request.resource.data.studentId == request.auth.token.studentId &&
                                          request.resource.data.blockId is string &&
                                          request.resource.data.blockType in ['interactive_prompt', 'collaborative_board'] &&
                                          responseId == request.resource.data.studentId + '_' + request.resource.data.blockId;
              }
            }
          }

          // ── Exams (ConnectUs Phase 2 — Exams foundation) ──────────────────
          // Config only: questions, point values, time limit, and the isLive
          // toggle — never correct answers (those live in exam_answer_keys,
          // section 11, a top-level collection denied to every client).
          // Like assignments/posts above, this is a NAMED nested match, not
          // covered by the recursive-wildcard fallback below (see the NOTE
          // on section 3a for why a recursive wildcard doesn't work anywhere
          // in this subtree) — without this block, exams was UNREACHABLE by
          // any rule and every read/write fell through to the final deny-all.
          //
          // READ: same broad same-school grant as assignments/posts — no
          //       student data lives here, so no per-class isolation needed.
          //
          // CREATE/UPDATE: teacher/admin only, not the same broad grant as
          //       assignments/posts. Reason: isLive/liveStartedAt/liveEndsAt
          //       control whether students can currently start or submit an
          //       exam attempt (see startExamAttempt, functions/index.js) —
          //       a student able to write this document could flip isLive
          //       true to start their own exam early, or extend liveEndsAt
          //       to grant themselves extra time. There is no legitimate
          //       student write path to this collection at all.
          match /exams/{examId} {
            allow read: if isCallerInSchool(schoolId) && isSchoolActive(schoolId);

            allow create, update: if isCallerInSchool(schoolId) && isSchoolActive(schoolId) &&
                                      request.auth.token.role in ['teacher', 'super_admin', 'sub_admin'];

            allow delete: if false; // soft-delete/archive only, matches house convention elsewhere
          }
        }
      }

      // ConnectUs classroom data (subjects, assignments — metadata only,
      // class-stream posts, exam metadata and question prompts,
      // class_sessions, attendance, behavior_points) is intentionally
      // covered by this wildcard: none of it is sensitive on its own, and it
      // inherits the same "school is active" gate everything else here
      // does. Nothing that must be hidden from a specific student (a
      // submission, an exam answer key) may ever be added anywhere under
      // schools/{schoolId} — this wildcard's grant is OR'd with any rule
      // written for a nested path, so a stricter rule placed here could never
      // actually restrict it. Those live under students/{studentId} (see
      // section 2a/2b above) or their own denied-by-default top-level
      // collection (see exam_answer_keys, section 11) instead.
      //
      // semesters and teaching_assignments are named above instead of left
      // to this wildcard — see the comment on those blocks: `list` is not
      // granted through a recursive-wildcard rule, only `get`, so anything
      // queried via getDocs(collection(...)) (not just fetched by a known
      // document ID) needs its own named match here to actually work.
      match /{subcollection=**} {
        // The entire 'classes' subtree (the class doc itself, and everything
        // nested under it) is handled by section 3a above instead — checking
        // subcollection[0] (index access, supported) rather than
        // subcollection.size() (NOT a supported method on this bound value —
        // see the note in section 3a) is enough to exclude all of it here,
        // since section 3a now explicitly matches every known nested
        // collection under classes/{classId} by name (attendance, subjects,
        // and subjects' own assignments/posts/submissions).
        //
        // READ/UPDATE/DELETE: caller identity + active school (Pass A).
        //                     isSchoolActive(schoolId) alone previously let
        //                     ANY caller — including an unauthenticated one,
        //                     since isSchoolActive never inspects request.auth
        //                     — read, edit, or delete subjects/
        //                     teaching_assignments/attendance/
        //                     behavior_points/semesters etc. belonging to ANY
        //                     active school, not just the caller's own.
        allow read, update, delete: if subcollection[0] != 'classes' &&
                                        isCallerInSchool(schoolId) && isSchoolActive(schoolId);

        // CREATE: same normal-path + scoped-bootstrap-path shape as the
        //         admins block above — see that block's comment for why
        //         !exists(...) is required to close the replay hole.
        allow create: if subcollection[0] != 'classes' && (
                          (isCallerInSchool(schoolId) && isSchoolActive(schoolId)) ||
                          (!exists(/databases/$(database)/documents/schools/$(schoolId)) &&
                           existsAfter(/databases/$(database)/documents/schools/$(schoolId)) &&
                           getAfter(/databases/$(database)/documents/schools/$(schoolId)).data.isVerified == true)
                        );
      }
    }

    // ── 4. Quote Requests & Onboarding ────────────────────────────────────
    match /quote_requests/{requestId} {
      // CREATE: public — landing.js quote form is unauthenticated.
      allow create: if true;

      // READ: unauthenticated onboarding reads its own quote by ID using the
      //       link from HQ email. HQ dashboard reads/lists all quotes.
      //       Keeping open because the quote ID is unguessable and list is
      //       only used by HQ (which has its own auth layer in the app).
      allow read: if true;

      // UPDATE: two legitimate paths —
      //   (a) HQ (platform_admin) manages quotes from the dashboard.
      //   (b) Unauthenticated onboarding.js marks the quote fulfilled and
      //       writes generatedSchoolId after creating the school. This is
      //       the ONLY field set onboarding is allowed to touch, and only
      //       while the quote is still unfulfilled.
      allow update: if (request.auth != null &&
                        request.auth.token.role == 'platform_admin') ||
                       (resource.data.fulfilled == false &&
                        request.resource.data.fulfilled == true &&
                        request.resource.data.diff(resource.data).affectedKeys()
                          .hasOnly(['fulfilled', 'generatedSchoolId']));

      // DELETE: disabled.
      allow delete: if false;
    }

    // ── 5. Subscription Plans (read-only from client) ─────────────────────
    match /subscriptionPlans/{planId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    // ── 6. Reset Vault (one-time PIN reset tokens) ────────────────────────
    // reset_vault does NOT store a Firebase Auth uid — it stores email,
    // userType, targetId, expiresAt. The reset-pin.html page reads and
    // deletes the token while the user is unauthenticated (that is the
    // entire point of a PIN reset). Token IDs are auto-generated and
    // unguessable; list is disabled so they cannot be enumerated.
    match /reset_vault/{tokenId} {
      allow get:    if true;
      allow list:   if false;
      allow create: if true;
      allow update: if false;
      allow delete: if true;
    }

    // ── 7. Platform Admins (ConnectUs HQ) ─────────────────────────────────
    // HQ dashboard (hq-team.js) reads, creates, updates, and deletes
    // platform_admin docs from the client using the HQ Firebase Auth session.
    // hq-login.js reads the doc after authenticating.
    // Restricted to HQ platform_admin tokens only — school users (teachers,
    // students, admins) authenticated via mintXToken cannot read or write.
    match /platform_admins/{adminId} {
      allow read, write: if request.auth != null &&
                            request.auth.token.role == 'platform_admin';
    }

    // ── 8. Organizations (Ministry of Ed, Districts, etc.) ────────────────
    // hq-organizations.js reads and writes from the HQ dashboard.
    // Restricted to HQ platform_admin tokens only.
    match /organizations/{orgId} {
      allow read, write: if request.auth != null &&
                            request.auth.token.role == 'platform_admin';
    }

    // ── 9. Payments / Revenue Logs ────────────────────────────────────────
    // hq-schools.js and hq-approvals.js create and read payment records
    // from the HQ dashboard. Restricted to HQ platform_admin tokens only.
    match /payments/{paymentId} {
      allow read, write: if request.auth != null &&
                            request.auth.token.role == 'platform_admin';
    }

    // ── 10. Registered Emails (duplicate check & account recovery) ────────
    // GET: must remain open — landing.js (unauthenticated quote form),
    //      onboarding.js (unauthenticated school creation), and
    //      forgot-pin.html all check email existence before any auth exists.
    // CREATE: open — onboarding.js (unauthenticated) creates during school
    //         setup; authenticated portals also create.
    // DELETE: authenticated only — admin/teacher/student settings delete
    //         the old entry when changing their email. Closing this from
    //         public prevents anonymous attackers from freeing email
    //         reservations to hijack them.
    // LIST: disabled — no code lists this collection.
    // UPDATE: disabled — entries are delete-and-recreate, never updated.
    match /registered_emails/{email} {
      allow get:    if true;
      allow create: if true;
      allow delete: if request.auth != null;
      allow list:   if false;
      allow update: if false;
    }

    // ── 11. Exam Answer Keys (ConnectUs Phase 2) ──────────────────────────
    // Correct answers for auto-graded exam questions. Deliberately its own
    // top-level collection, not nested under schools/{schoolId} (see the
    // comment in section 3) and not readable or writable by ANY client,
    // teacher or admin included — only the autoGradeObjectiveAnswers Cloud
    // Function, running with Admin SDK privileges that bypass these rules
    // entirely, ever touches this collection. A teacher builds and edits
    // the answer key through that same function, never a direct client write.
    match /exam_answer_keys/{examId} {
      allow read, write: if false;
    }

    // ── 11a. Work (Add Work rebuild) answer key isolation ──────────────────
    // Same goal as exam_answer_keys — correct answers must never be
    // client-readable, by the teacher's own session included — but a
    // different mechanism: there's no Cloud Function that writes this
    // collection (there isn't one for exam_answer_keys either yet), so the
    // teacher's client writes it directly in the same batch as the clean
    // assignment doc. Read stays permanently denied to every client, which
    // is the actual security property that matters here.
    //
    // This is a TOP-LEVEL collection, so there's no {schoolId} path segment
    // to check isCallerInSchool against the way every nested rule above
    // does. Tenant scoping instead comes from the caller's own
    // server-issued custom claim compared against the schoolId field IN
    // THE DOCUMENT BEING WRITTEN (request.resource.data) — a teacher can
    // only ever create a key doc claiming their own schoolId, since
    // request.auth.token.schoolId cannot be forged from the client.
    //
    // create only — no update, no delete, matching the write-once intent:
    // once a key is written, no client (compromised teacher session
    // included) can silently alter or erase it afterward. hasOnly locks
    // the document to exactly the four fields the schema defines, so this
    // can't be repurposed to smuggle arbitrary data past the deny-all
    // fallback.
    match /work_answer_keys/{assignmentId} {
      allow read, update, delete: if false;
      allow create: if request.auth != null &&
                       request.auth.token.role in ['teacher', 'super_admin', 'sub_admin'] &&
                       request.auth.token.schoolId == request.resource.data.schoolId &&
                       isSchoolActive(request.resource.data.schoolId) &&
                       request.resource.data.assignmentId == assignmentId &&
                       request.resource.data.keys().hasOnly(['assignmentId', 'schoolId', 'keys', 'createdAt']);
    }

    // ── 12. Deny everything else ───────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
